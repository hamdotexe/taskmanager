<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.HeaderBar?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- The window: the header in place of the title bar, the sidebar, and the task list; dialogs open over it all -->
<StackPane fx:id="layers" xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="io.mcs.taskmanager.ui.MainWindowController">
    <BorderPane>
        <top>
            <HeaderBar styleClass="header">
                <left>
                    <HBox fx:id="brand" styleClass="header-brand" minWidth="240" prefWidth="240" maxWidth="240"/>
                </left>
            </HeaderBar>
        </top>
        <left>
            <VBox styleClass="sidebar" minWidth="240" prefWidth="240" maxWidth="240">
                <VBox fx:id="filters" styleClass="group"/>
                <Region VBox.vgrow="ALWAYS"/>
                <VBox fx:id="shortcuts" styleClass="group"/>
            </VBox>
        </left>
        <center>
            <VBox styleClass="content" minWidth="0">
                <HBox alignment="BOTTOM_LEFT" spacing="8">
                    <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label fx:id="heading" styleClass="title"/>
                        <Label fx:id="summary" styleClass="caption" minWidth="0"/>
                    </VBox>
                    <Button fx:id="refreshButton" text="Refresh" styleClass="btn, secondary" minWidth="-Infinity"
                            onAction="#refresh"/>
                    <Button fx:id="addButton" text="Add task" styleClass="btn, primary" minWidth="-Infinity"
                            onAction="#add"/>
                </HBox>
                <HBox fx:id="searchBox" styleClass="search">
                    <TextField fx:id="search" promptText="Search titles and descriptions" minWidth="0"/>
                </HBox>
                <VBox fx:id="noticeSlot"/>
                <VBox styleClass="card" VBox.vgrow="ALWAYS" minHeight="0">
                    <HBox fx:id="listHead" styleClass="list-head"/>
                    <ListView fx:id="list" styleClass="task-list" VBox.vgrow="ALWAYS" minHeight="0"/>
                    <VBox fx:id="empty" styleClass="empty" VBox.vgrow="ALWAYS"/>
                </VBox>
            </VBox>
        </center>
    </BorderPane>
</StackPane>
